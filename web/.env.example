# Copy to .env.local (git-ignored) to override settings on your machine.
#
# VITE_API_BASE_URL: base URL of the Super Projector API, without a trailing
# slash. Vite builds this into the JavaScript bundle, so it is visible to
# anyone using the site. Never put secrets in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:5080
